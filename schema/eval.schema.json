{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bassimeledath/open-eval/schema/eval.schema.json",
  "title": "Open Eval file",
  "type": "object",
  "required": ["openeval", "name", "kind", "target", "scorers", "cases"],
  "additionalProperties": false,
  "properties": {
    "openeval": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "kind": {"enum": ["single_turn", "multi_turn"]},
    "description": {"type": "string"},
    "target": {"$ref": "#/$defs/target"},
    "trial_count": {"type": "integer", "minimum": 1, "default": 1},
    "scorers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scorer"},
      "contains": {"type": "object", "required": ["pass"]}
    },
    "cases": {
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {"file": {"type": "string"}}
        }
      ]
    },
    "tags": {"$ref": "#/$defs/tags"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "tags": {"type": "array", "items": {"type": "string"}},
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string"},
        "http": {"type": "string", "format": "uri"},
        "function": {"type": "string", "pattern": "^.+:[A-Za-z_][A-Za-z0-9_]*$"}
      }
    },
    "scorer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "oneOf": [{"required": ["check"]}, {"required": ["judge"]}],
      "properties": {
        "name": {"type": "string"},
        "check": {"type": "string"},
        "judge": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
        "params": {"type": "object"},
        "pass": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "each": {"type": "number", "minimum": 0, "maximum": 1},
            "mean": {"type": "number", "minimum": 0, "maximum": 1},
            "vs_baseline": {"type": "number", "maximum": 0}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"$ref": "#/$defs/expected"},
        "tags": {"$ref": "#/$defs/tags"},
        "metadata": {"type": "object"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "not": {"required": ["persona", "script"]},
      "properties": {
        "message": {"type": "string"},
        "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
        "data": {"type": "object"},
        "start_state": {"type": "object"},
        "persona": {"type": "string"},
        "script": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "max_turns": {"type": "integer", "minimum": 1},
        "stop_when": {"type": "object"}
      },
      "dependentRequired": {
        "persona": ["max_turns"],
        "script": ["max_turns"]
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "tools_called": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["name"],
                "properties": {"name": {"type": "string"}, "args": {"type": "object"}}
              }
            ]
          }
        },
        "tools_not_called": {"type": "array", "items": {"type": "string"}},
        "actions": {"type": "array", "items": {"type": "string"}},
        "equals": {"type": "object"},
        "reply_contains": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "string"}},
        "reference": {}
      }
    }
  }
}
