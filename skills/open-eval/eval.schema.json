{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bassimeledath/open-eval/skills/open-eval/eval.schema.json",
  "title": "Open Eval file",
  "type": "object",
  "required": ["openeval", "name", "target", "scorers", "cases"],
  "additionalProperties": false,
  "properties": {
    "openeval": {"const": 1},
    "name": {"$ref": "#/$defs/name"},
    "description": {"type": "string"},
    "target": {"$ref": "#/$defs/endpoint"},
    "trial_count": {"type": "integer", "minimum": 1},
    "scorers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scorer"},
      "contains": {"type": "object", "required": ["pass"]}
    },
    "cases": {
      "oneOf": [
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        {
          "type": "object",
          "required": ["file"],
          "additionalProperties": false,
          "properties": {"file": {"type": "string"}}
        }
      ]
    },
    "tags": {"$ref": "#/$defs/tags"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "endpoint": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "http": {"type": "string", "pattern": "^https?://"}
      }
    },
    "builtin_check": {
      "enum": ["equals", "reply_contains", "tool_called", "tool_not_called", "latency_p95_ms", "cost_per_trial_usd"]
    },
    "scorer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "oneOf": [{"required": ["check"]}, {"required": ["judge"]}],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "check": {"oneOf": [{"$ref": "#/$defs/builtin_check"}, {"$ref": "#/$defs/endpoint"}]},
        "judge": {"$ref": "#/$defs/name"},
        "scope": {"enum": ["trial", "run"]},
        "pass": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "each": {"type": "number", "minimum": 0, "maximum": 1},
            "mean": {"type": "number", "minimum": 0, "maximum": 1},
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "input": {"$ref": "#/$defs/input"},
        "expected": {"type": "object"},
        "tags": {"$ref": "#/$defs/tags"},
        "metadata": {"type": "object"}
      }
    },
    "part": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {"type": {"const": "text"}, "text": {"type": "string"}}
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": {"type": {"const": "file"}, "path": {"type": "string"}, "mime": {"type": "string"}}
        }
      ]
    },
    "content": {
      "oneOf": [
        {"type": "string"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
      ]
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"$ref": "#/$defs/content"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["message"]},
        {"required": ["messages"]},
        {"required": ["data"]},
        {"required": ["script"]},
        {"required": ["persona"]}
      ],
      "not": {"anyOf": [
        {"required": ["persona", "script"]},
        {"required": ["message", "messages"]}
      ]},
      "dependentRequired": {
        "persona": ["max_turns"],
        "script": ["max_turns"]
      },
      "properties": {
        "message": {"$ref": "#/$defs/content"},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
        "data": {"type": "object"},
        "state": {"type": "object"},
        "script": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/content"}},
        "persona": {"type": "string", "minLength": 1},
        "max_turns": {"type": "integer", "minimum": 1},
        "stop_when": {"type": "object", "minProperties": 1}
      }
    }
  }
}
